# ─────────────────────────────────────────────────────────────
#  tiktok-factory · variables de entorno
#  Copia este archivo a .env y llena los valores.
#  NUNCA subas .env al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# 1) Google AI Studio / Gemini API  →  https://aistudio.google.com/apikey
#    Cubre: Veo (video con audio nativo) + Gemini TTS (narración).
GEMINI_API_KEY=

# Modelos (verifícalos en la consola antes de correr; cambian de nombre seguido)
VEO_MODEL=veo-3.1-generate-preview
TTS_MODEL=gemini-2.5-flash-preview-tts

# 2) Google Drive
#    Opción A (recomendada): cuenta de servicio.
#      - Crea la service account en Google Cloud, descarga el JSON.
#      - Comparte tu carpeta de Drive con el email de la service account (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=/ruta/absoluta/service-account.json
#    Opción B: OAuth de usuario (si prefieres tu cuenta personal)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ID de la carpeta raíz de Drive donde se guarda todo (el string del URL)
DRIVE_ROOT_FOLDER_ID=

# 3) Voz premium (OPCIONAL — solo si activas el proveedor elevenlabs)
#    Requiere que el entorno permita salida a api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 4) Ajustes de producción
VIDEOS_PER_DAY=2
TZ=America/Bogota
